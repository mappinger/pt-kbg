{% from "partials/icons.njk" import icon %}
<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }} – zur Startseite">
      <img src="/images/logo.jpg" alt="{{ site.name }}" width="200" height="71" eleventy:ignore>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation" data-nav-toggle>
      <span class="nav-toggle__open">{{ icon("menu") }}</span><span class="nav-toggle__close">{{ icon("close") }}</span>
      <span class="visually-hidden">Menü</span>
    </button>
    <nav class="main-nav" id="hauptnavigation" aria-label="Hauptnavigation" data-nav>
      <ul>
        {%- for link in navigation.links %}
        {%- set aktiv = (link.url == "/" and page.url == "/") or (link.url != "/" and (page.url or "").startsWith(link.url)) %}
        <li><a href="{{ link.url }}"{% if aktiv %} aria-current="page"{% endif %}>{{ link.titel }}</a></li>
        {%- endfor %}
      </ul>
      <a class="btn btn--primary btn--small main-nav__cta" href="/kontakt/">{{ icon("phone") }} Termin vereinbaren</a>
    </nav>
  </div>
</header>
